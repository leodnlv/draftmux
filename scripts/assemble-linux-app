#!/usr/bin/env bash
# Assemble a relocatable Linux app tree from an already-built binary. With
# RELEASE_VERSION, the tree is marked as that release's, which installed
# copies of it update themselves from.
set -euo pipefail
if [[ $# -lt 2 || $# -gt 3 || ! -f $1 || ! -d $2 ]]; then
  echo "usage: assemble-linux-app BINARY OUTPUT_DIR [RELEASE_VERSION]" >&2
  exit 2
fi
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
app="$2/draftmux-linux"
if [[ -e $app || -L $app ]]; then
  echo "refusing to replace $app" >&2
  exit 1
fi
mkdir -p "$app/bin" "$app/share/draftmux/pi-extension" "$app/share/applications" \
  "$app/share/icons/hicolor/1024x1024/apps"
install -m755 "$1" "$app/bin/draftmux"
install -m644 "$root/pi-extension/draftmux.ts" "$app/share/draftmux/pi-extension/"
install -m644 "$root/linux/fi.zendit.Draftmux.desktop" "$app/share/applications/"
install -m644 "$root/macos/app-icon.png" "$app/share/icons/hicolor/1024x1024/apps/fi.zendit.Draftmux.png"
install -m755 "$root/scripts/install-linux-app" "$app/install"
printf 'draftmux\n' > "$app/.draftmux-bundle"
if [[ $# -eq 3 ]]; then printf '%s\n' "$3" > "$app/.draftmux-release"; fi
printf '%s\n' "$app"
