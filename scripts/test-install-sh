#!/usr/bin/env bash
# Runs the public install.sh on macOS against stub releases served from
# temporary directories and checks installing, updating, that anything other
# than a previous Draftmux install is left alone, and that a failed swap
# restores the installed app. codesign is stubbed to accept the unsigned
# stub bundles.
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
installer="$script_dir/../install.sh"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

# A release VERSION whose command prints "VERSION ARGS".
release() {
  local dir="$tmp/releases/download/v$1" name="Draftmux-$1-arm64-app"
  mkdir -p "$dir" "$tmp/build/$1"
  printf '#!/bin/sh\necho "%s $*"\n' "$1" >"$tmp/build/$1/draftmux"
  "$script_dir/assemble-macos-app" "$tmp/build/$1/draftmux" "$1" "$tmp/build/$1" >/dev/null
  tar -czf "$dir/$name.tar.gz" -C "$tmp/build/$1" Draftmux.app
  (cd "$dir" && shasum -a 256 "$name.tar.gz" >"$name.sha256")
}

mkdir -p "$tmp/stubs"
printf '#!/bin/sh\nexit 0\n' >"$tmp/stubs/codesign"
# Fails moving a staged Draftmux.app into place, like a full or read-only
# destination.
cat >"$tmp/stubs/failing-mv" <<'STUB'
#!/bin/sh
case $1 in */.Draftmux-install.*/Draftmux.app) exit 1 ;; esac
exec /bin/mv "$@"
STUB
chmod +x "$tmp/stubs/codesign" "$tmp/stubs/failing-mv"

# Installs VERSION into the home directory $tmp/HOME.
run() {
  mkdir -p "$tmp/$2"
  HOME="$tmp/$2" PATH="$tmp/stubs:$PATH" DRAFTMUX_VERSION="$1" \
    DRAFTMUX_RELEASES_URL="file://$tmp/releases" DRAFTMUX_APP_DIR="$tmp/$2/apps" \
    DRAFTMUX_INSTALL_PREFIX="$tmp/$2/.local" sh "$installer" >"$tmp/install.log" 2>&1
}
reject() {
  if run "$@"; then
    fail "accepted invalid install: $*"
  fi
}

release 1.0.0
release 2.0.0
apps="$tmp/home/apps"
bin="$tmp/home/.local/bin"
run 1.0.0 home || fail "install failed: $(<"$tmp/install.log")"
[[ -L $bin/draftmux && $(readlink "$bin/draftmux") == "$apps/Draftmux.app/Contents/MacOS/draftmux" ]] ||
  fail "draftmux does not link into the installed app"
[[ $("$bin/draftmux" x) == "1.0.0 x" ]] || fail "linked command did not run the installed app"

run 2.0.0 home || fail "update failed: $(<"$tmp/install.log")"
[[ $("$bin/draftmux" x) == "2.0.0 x" ]] || fail "update did not replace the app"
[[ $(find "$apps" -mindepth 1 -maxdepth 1) == "$apps/Draftmux.app" ]] || fail "update left files in $apps"

# A failed swap puts the installed app back and cleans up the staging.
mkdir -p "$tmp/stubs/fail"
ln -s ../failing-mv "$tmp/stubs/fail/mv"
if PATH="$tmp/stubs/fail:$PATH" run 1.0.0 home; then fail "a failed swap succeeded"; fi
grep -q "couldn't move Draftmux.app" "$tmp/install.log" || fail "unexpected failure: $(<"$tmp/install.log")"
[[ $("$bin/draftmux" x) == "2.0.0 x" ]] || fail "a failed swap lost the installed app"
[[ $(find "$apps" -mindepth 1 -maxdepth 1) == "$apps/Draftmux.app" ]] || fail "a failed swap left files in $apps"

# A different app at the destination stays, and nothing is linked.
mkdir -p "$tmp/foreign/apps"
cp -R "$tmp/build/1.0.0/Draftmux.app" "$tmp/foreign/apps/"
/usr/bin/plutil -replace CFBundleIdentifier -string com.example.Other "$tmp/foreign/apps/Draftmux.app/Contents/Info.plist"
reject 2.0.0 foreign
[[ $(/usr/bin/plutil -extract CFBundleIdentifier raw "$tmp/foreign/apps/Draftmux.app/Contents/Info.plist") == com.example.Other ]] ||
  fail "replaced a foreign app"
[[ ! -e $tmp/foreign/.local ]] || fail "linked after refusing the app"

# So does a regular file where the link goes, and the app isn't installed.
mkdir -p "$tmp/file/.local/bin"
echo keep >"$tmp/file/.local/bin/draftmux"
reject 2.0.0 file
[[ $(<"$tmp/file/.local/bin/draftmux") == keep && ! -e $tmp/file/apps ]] || fail "replaced a regular file"

# So does a link to another command, even a dangling one.
for target in /usr/bin/true "$tmp/nowhere/draftmux"; do
  rm -rf "$tmp/link"
  mkdir -p "$tmp/link/.local/bin"
  ln -s "$target" "$tmp/link/.local/bin/draftmux"
  reject 2.0.0 link
  [[ $(readlink "$tmp/link/.local/bin/draftmux") == "$target" && ! -e $tmp/link/apps ]] ||
    fail "replaced a link to $target"
done

# A link into a Draftmux.app elsewhere is a previous install and is moved.
mkdir -p "$tmp/moved/.local/bin"
ln -s "$tmp/old/Draftmux.app/Contents/MacOS/draftmux" "$tmp/moved/.local/bin/draftmux"
run 2.0.0 moved || fail "refused a previous install's link: $(<"$tmp/install.log")"
[[ $("$tmp/moved/.local/bin/draftmux" x) == "2.0.0 x" ]] || fail "did not relink a previous install"

# A download that doesn't match its checksum installs nothing.
release 3.0.0
echo tampered >>"$tmp/releases/download/v3.0.0/Draftmux-3.0.0-arm64-app.tar.gz"
reject 3.0.0 tampered
grep -q "checksum mismatch" "$tmp/install.log" || fail "unexpected failure: $(<"$tmp/install.log")"
[[ ! -e $tmp/tampered/apps && ! -e $tmp/tampered/.local ]] || fail "installed a tampered download"

echo "ok: install.sh installs and updates the app and command link, restores the app after a failed swap, and leaves foreign apps, files, links and tampered downloads alone"
